# 연락 폼(EmailJS)
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# 사용 분석(PostHog). 비워 두면 분석을 켜지 않는다. 프로덕션 빌드에서만 동작한다.
# 로컬은 .env에, 배포는 Vercel 프로젝트 Settings → Environment Variables에 넣는다(.env는 커밋하지 않는다).
VITE_POSTHOG_PROJECT_TOKEN=
# PostHog 리전 호스트(US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
VITE_POSTHOG_HOST=https://us.i.posthog.com
